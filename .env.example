# ─────────────────────────────────────────────────────────────
# TINY CONVOY — environment
# Everything here is OPTIONAL. With no .env at all the game runs
# in MOCK MODE: full offline play, local persistence, fake
# leaderboard, simulated wallet. Nothing is gated.
# ─────────────────────────────────────────────────────────────

# ── Client (must be VITE_ prefixed) ──────────────────────────
# Supabase project — enables cloud profile + global leaderboard.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Solana. network: devnet | testnet | mainnet-beta
VITE_SOLANA_NETWORK=devnet
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com

# SPL mint for the $CONVOY placeholder ticker. Leave blank for mock balances.
VITE_CONVOY_MINT=
VITE_CONVOY_SYMBOL=CONVOY
VITE_CONVOY_DECIMALS=9

# Treasury that receives expedition entry fees. Leave blank to disable entry.
VITE_CONVOY_TREASURY=

# Minimum verified balance (UI units) for holder cosmetics / premium expedition.
VITE_MIN_HOLDER_BALANCE=100
VITE_EXPEDITION_ENTRY_FEE=25

# Force mock mode even when credentials exist (useful for demos/tests).
VITE_FORCE_MOCK=false

# ── Server (Vercel functions — never exposed to the client) ──
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 32+ random bytes. Signs expedition session tickets. `openssl rand -hex 32`
SESSION_SECRET=
# RPC used server-side to verify wallet balances.
SOLANA_RPC_URL=https://api.devnet.solana.com
CONVOY_MINT=
# Server-side fallback for the holder-cosmetics/premium-expedition threshold.
# Falls back to VITE_MIN_HOLDER_BALANCE, then to 100, if unset.
MIN_HOLDER_BALANCE=100
